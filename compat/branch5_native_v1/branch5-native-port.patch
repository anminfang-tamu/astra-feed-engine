+++ b/scripts/build_branch5_native_replay.sh
@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+PINNED_COMMIT=324d81a15ee52cc72f68873a1ced122923406df2
+
+if [[ $# -gt 1 ]]; then
+  echo "usage: scripts/build_branch5_native_replay.sh [BUILD_DIR]" >&2
+  exit 2
+fi
+
+root_dir="$(git rev-parse --show-toplevel)"
+build_dir="${1:-${root_dir}/build/branch5-native-release}"
+commit="$(git -C "${root_dir}" rev-parse HEAD)"
+if [[ -n "$(git -C "${root_dir}" status --porcelain=v1 --untracked-files=all)" ]]; then
+  echo "branch5 native replay requires a clean compatibility-port commit" >&2
+  exit 2
+fi
+parent_commit="$(git -C "${root_dir}" rev-parse HEAD^)"
+if [[ "${parent_commit}" != "${PINNED_COMMIT}" ]] ||
+   [[ "$(git -C "${root_dir}" rev-list --count "${PINNED_COMMIT}..${commit}")" != 1 ]]; then
+  echo "branch5 native replay requires one compatibility commit directly atop ${PINNED_COMMIT}" >&2
+  exit 2
+fi
+expected_paths="$(printf '%s\n' \
+  benchmarks/Branch5ItchBookReplayBenchmark.cpp \
+  benchmarks/Branch5NativeStorage.hpp \
+  benchmarks/Branch5ReplayBackend.hpp \
+  benchmarks/Branch5ReplayTime.cpp \
+  benchmarks/CMakeLists.txt \
+  include/astra/book/BookManager.hpp \
