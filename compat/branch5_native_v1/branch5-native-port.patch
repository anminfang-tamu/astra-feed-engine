+};
+
+Distribution summarize(std::vector<std::uint64_t> &ticks) {
+  if (ticks.empty())
+    throw std::runtime_error("no timed book samples were collected");
+  for (std::uint64_t &sample : ticks)
+    sample = elapsedRdtscNs(0, sample);
+  std::sort(ticks.begin(), ticks.end());
+  return {percentile(ticks, 50, 100), percentile(ticks, 90, 100),
+          percentile(ticks, 99, 100), percentile(ticks, 999, 1000),
+          ticks.back()};
+}
+
+void printTypeDistribution(unsigned char type, std::size_t sample_count,
+                           const Distribution &distribution) {
+  std::cout << "itch_book_replay_type"
+            << " type=" << static_cast<char>(type)
+            << " sample_count=" << sample_count
+            << " p50_ns=" << distribution.p50
+            << " p90_ns=" << distribution.p90
+            << " p99_ns=" << distribution.p99
+            << " p99_9_ns=" << distribution.p999
+            << " max_ns=" << distribution.maximum << '\n';
+}
+
+std::size_t systemPageBytes() {
+  const long value = ::sysconf(_SC_PAGESIZE);
+  return value > 0 ? static_cast<std::size_t>(value) : 4096u;
+}
+
+bool bookStatsClean(const BookManagerStats &stats) noexcept {
+  return stats.invalid_adds == 0 && stats.duplicate_order_refs == 0 &&
+         stats.missing_order_refs == 0 && stats.stale_order_refs == 0 &&
+         stats.mutation_failures == 0 &&
+         stats.order_ref_index_insert_failures == 0 &&
+         stats.order_ref_index_replace_failures == 0 &&
+         stats.order_ref_index_erase_failures == 0 &&
+         stats.late_book_creation_attempts == 0 &&
+         stats.book_creation_failures == 0 && stats.allocation_failures == 0 &&
+         stats.price_rejections == 0 && stats.locally_invalid_books == 0 &&
+         stats.inconsistent_books == 0;
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  try {
+    if (argc == 2 && std::string_view(argv[1]) == "--help") {
+      std::cout << kUsage << '\n';
+      return EXIT_SUCCESS;
+    }
+    const Options options = parseOptions(argc, argv);
+    const Branch5ReplayConfig config{
+        options.default_order_capacity,
+        {options.price_node_capacity, options.price_leaf_capacity,
+         options.price_level_capacity},
+    };
+    Branch5ReplayBackend backend(config);
+    const PriceLevelArena &prices = backend.books().priceLevelArena();
+    const std::array<std::size_t, 6> price_pool_bytes{
+        prices.nodesBytes(),       prices.leavesBytes(),
+        prices.levelsBytes(),      prices.freeNodesBytes(),
+        prices.freeLeavesBytes(),  prices.freeLevelsBytes(),
+    };
+    std::uint64_t planned_price_pool_bytes = 0;
+    for (const std::size_t bytes : price_pool_bytes) {
+      if (bytes > std::numeric_limits<std::uint64_t>::max() -
+                      planned_price_pool_bytes)
+        throw std::overflow_error("price-pool plan overflows uint64");
+      planned_price_pool_bytes += bytes;
+    }
+    std::cout << "itch_book_replay_storage_plan"
+              << " hot_arena_schema=" << kBranch5HotArenaSchema
+              << " system_page_bytes=" << systemPageBytes()
+              << " price_nodes_bytes=" << price_pool_bytes[0]
+              << " price_leaves_bytes=" << price_pool_bytes[1]
+              << " price_levels_bytes=" << price_pool_bytes[2]
+              << " price_free_nodes_bytes=" << price_pool_bytes[3]
+              << " price_free_leaves_bytes=" << price_pool_bytes[4]
+              << " price_free_levels_bytes=" << price_pool_bytes[5]
+              << " planned_price_pool_bytes=" << planned_price_pool_bytes
+              << " default_order_capacity="
+              << options.default_order_capacity
+              << " price_internal_node_capacity="
+              << options.price_node_capacity
+              << " price_leaf_capacity=" << options.price_leaf_capacity
+              << " price_level_capacity=" << options.price_level_capacity
+              << " prefault=" << (options.prefault ? 1 : 0) << '\n'
+              << std::flush;
+    if (options.storage_plan_only)
+      return EXIT_SUCCESS;
+
+    requirePathAbsent(options.native_range_manifest,
+                      "native range manifest");
+    requirePathAbsent(options.start_gate_file, "start gate file");
+    std::ifstream input(options.path, std::ios::binary);
+    if (!input.is_open())
+      throw std::runtime_error("failed to open input file");
+    std::vector<char> file_buffer(16u * 1024u * 1024u);
+    input.rdbuf()->pubsetbuf(file_buffer.data(),
+                            static_cast<std::streamsize>(file_buffer.size()));
+    std::vector<unsigned char> message(1u << 16);
+    std::vector<TimedSample> samples;
+    samples.resize(options.sample_capacity);
+    samples.clear();
+    std::optional<SemanticMutationDigester> semantic_digester;
+    if (options.mutation_digest)
+      semantic_digester.emplace();
+
+    const TimeCalibration &calibration = timeCalibration();
+    std::uint64_t records = 0;
+    std::uint64_t bytes = 0;
+    std::uint64_t book_messages = 0;
+    std::uint64_t applied_book_mutations = 0;
+    std::uint64_t mutation_digest = kDigestOffset;
+    std::uint64_t prelude_records = 0;
+    std::uint64_t prelude_bytes = 0;
+    Branch5NativeRangeSummary native_ranges{};
+    bool ready_emitted = false;
+    rusage post_warmup_start{};
+    rusage post_warmup_end{};
+    bool post_warmup_usage_started = false;
+
+    for (;;) {
+      unsigned char length_bytes[2]{};
+      input.read(reinterpret_cast<char *>(length_bytes), 2);
+      if (input.gcount() == 0 && input.eof())
+        break;
+      if (input.gcount() != 2)
+        throw std::runtime_error("truncated record length");
+      const std::uint16_t length = readU16BE(length_bytes);
+      if (length == 0)
+        throw std::runtime_error("zero-length ITCH record");
+      input.read(reinterpret_cast<char *>(message.data()), length);
+      if (input.gcount() != static_cast<std::streamsize>(length))
+        throw std::runtime_error("truncated ITCH record");
+      ++records;
+      bytes += static_cast<std::uint64_t>(length) + 2;
+
+      const bool book_message = isBookMutation(message[0]);
+      if (!ready_emitted && book_message)
+        throw std::runtime_error(
+            "book mutation arrived before System Event S readiness gate");
+      const bool after_warmup =
+          book_message && book_messages >= options.warmup_book_messages;
+      const bool sample =
+          after_warmup &&
+          selectSample(book_messages - options.warmup_book_messages,
+                       options.sample_every);
+      SemanticPreMutation semantic_before{};
+      if (book_message && semantic_digester.has_value()) {
+        semantic_before = semantic_digester->captureBefore(
+            std::span<const unsigned char>(message.data(), length), backend);
+      }
+      std::uint64_t start = 0;
+      if (sample)
+        start = rdtsc();
+      const bool applied = backend.handleMessage(std::span<const std::byte>(
+          reinterpret_cast<const std::byte *>(message.data()), length));
+      if (sample) {
+        const std::uint64_t elapsed_ticks = rdtsc() - start;
+        if (samples.size() == samples.capacity())
+          throw std::runtime_error(
+              "timed sample capacity exceeded; increase --sample-every");
+        samples.push_back({elapsed_ticks, message[0]});
+      }
+      if (!backend.lastError().empty()) {
+        std::cerr << "record=" << records
+                  << " type=" << static_cast<char>(message[0])
+                  << " error=\"" << backend.lastError() << "\"\n";
+        return EXIT_FAILURE;
+      }
+
+      if (!ready_emitted && backend.readyForTimedReplay()) {
+        prelude_records = records;
+        prelude_bytes = bytes;
+        native_ranges = writeBranch5NativeRangeManifest(
+            options.native_range_manifest, backend.books());
+        const std::size_t prepared_books = backend.preparedBooks();
+        if (!backend.nativePrefaultComplete() || prepared_books == 0 ||
+            native_ranges.count != 6 + 4 * prepared_books)
+          throw std::runtime_error("native prefault/range readiness failed");
+        std::cout << "itch_book_replay_ready"
+                  << " hot_arena_schema=" << kBranch5HotArenaSchema
+                  << " prefault=" << (options.prefault ? 1 : 0)
+                  << " native_prefault_complete=1"
+                  << " book_universe_sealed=1"
+                  << " prepared_books=" << prepared_books
+                  << " native_range_manifest_schema="
+                  << kBranch5NativeRangeManifestSchema
+                  << " native_range_manifest="
+                  << std::quoted(options.native_range_manifest)
+                  << " native_range_count=" << native_ranges.count
+                  << " native_range_bytes=" << native_ranges.bytes
+                  << " native_range_digest=" << native_ranges.digest
+                  << " sample_capacity=" << options.sample_capacity
+                  << " sample_storage_prefaulted=1"
+                  << " prelude_records=" << prelude_records
+                  << " prelude_bytes=" << prelude_bytes
+                  << " sample_schedule_id=" << kSampleScheduleId
+                  << " sample_every=" << options.sample_every
+                  << " warmup_book_messages="
+                  << options.warmup_book_messages
+                  << " start_gate_enabled="
+                  << (options.start_gate_file.empty() ? 0 : 1) << '\n'
+                  << std::flush;
+        waitForStartGate(options.start_gate_file,
+                         options.start_gate_timeout_ms);
+        ready_emitted = true;
+        if (options.warmup_book_messages == 0) {
+          if (::getrusage(RUSAGE_SELF, &post_warmup_start) != 0)
+            throw std::runtime_error("getrusage failed before replay");
+          post_warmup_usage_started = true;
+        }
+      }
+
+      if (book_message)
+        ++book_messages;
+      if (!post_warmup_usage_started && ready_emitted &&
+          book_messages == options.warmup_book_messages) {
+        if (::getrusage(RUSAGE_SELF, &post_warmup_start) != 0)
+          throw std::runtime_error("getrusage failed after warmup");
+        post_warmup_usage_started = true;
+      }
+      if (book_message && applied) {
+        ++applied_book_mutations;
+        if (options.mutation_digest) {
+          observePhysicalMutation(
+              mutation_digest, records,
+              std::span<const unsigned char>(message.data(), length), backend);
+          semantic_digester->observeApplied(
+              applied_book_mutations,
+              std::span<const unsigned char>(message.data(), length),
+              semantic_before, backend);
+        }
+      }
+    }
+
+    if (!ready_emitted)
+      throw std::runtime_error(
+          "trace ended before System Event S prepared the book universe");
+    if (post_warmup_usage_started) {
+      if (::getrusage(RUSAGE_SELF, &post_warmup_end) != 0)
+        throw std::runtime_error("getrusage failed after replay");
+    }
+    const std::uint64_t post_warmup_minor_faults =
+        post_warmup_usage_started
+            ? static_cast<std::uint64_t>(post_warmup_end.ru_minflt -
+                                         post_warmup_start.ru_minflt)
+            : 0;
+    const std::uint64_t post_warmup_major_faults =
+        post_warmup_usage_started
+            ? static_cast<std::uint64_t>(post_warmup_end.ru_majflt -
+                                         post_warmup_start.ru_majflt)
+            : 0;
+
+    if (options.expected_records.has_value() &&
+        records != *options.expected_records)
+      throw std::runtime_error("record-count gate failed");
+    if (options.expected_bytes.has_value() && bytes != *options.expected_bytes)
+      throw std::runtime_error("byte-count gate failed");
+    if (samples.size() < options.minimum_samples)
+      throw std::runtime_error("minimum-sample gate failed");
+
+    std::uint64_t state_checksum = 0;
+    for (std::size_t slot = 1; slot < BookManager::kMaxStockLocate; ++slot) {
+      const OrderBook *const book =
+          backend.books().getOrderBook(static_cast<std::uint16_t>(slot));
+      if (book == nullptr)
+        continue;
+      const TopOfBook top = book->getTopOfBook();
+      state_checksum ^= top.bid_price + (top.bid_qty << 1) +
+                        (top.ask_price << 2) + (top.ask_qty << 3) + slot;
+    }
+
+    std::vector<std::uint64_t> scratch;
+    scratch.reserve(samples.size());
+    for (const TimedSample &sample : samples)
+      scratch.push_back(sample.ticks);
+    const Distribution distribution = summarize(scratch);
+    std::array<std::optional<Distribution>, kBookMutationTypes.size()>
+        type_distributions{};
+    std::array<std::size_t, kBookMutationTypes.size()> type_counts{};
+    for (std::size_t type_index = 0;
+         type_index < kBookMutationTypes.size(); ++type_index) {
+      scratch.clear();
+      for (const TimedSample &sample : samples) {
+        if (sample.type == kBookMutationTypes[type_index])
+          scratch.push_back(sample.ticks);
+      }
+      type_counts[type_index] = scratch.size();
+      if (!scratch.empty())
+        type_distributions[type_index] = summarize(scratch);
+    }
+
+    const PriceLevelArenaStats price_stats =
+        backend.books().priceLevelArena().stats();
+    const std::uint64_t price_failures = backend.priceCapacityFailures();
+    const BookManagerStats book_stats =
+        backend.books().stats(BookStatsDetail::ValidationOnly);
+    const std::uint64_t final_live_orders = backend.finalLiveOrders();
+    const std::size_t prepared_books = backend.preparedBooks();
+    std::cout << "itch_book_replay"
+              << " hot_arena_schema=" << kBranch5HotArenaSchema
+              << " path=" << std::quoted(options.path)
+              << " records=" << records << " bytes=" << bytes
+              << " book_messages=" << book_messages
+              << " applied_book_mutations=" << applied_book_mutations
+              << " sample_count=" << samples.size()
+              << " sample_every=" << options.sample_every
+              << " sample_strategy=fixed_seed_block_offset"
+              << " sample_schedule_id=" << kSampleScheduleId
+              << " warmup_book_messages="
+              << options.warmup_book_messages
+              << " min_samples=" << options.minimum_samples
+              << " sample_capacity=" << options.sample_capacity
+              << " sample_storage_prefaulted=1"
+              << " prelude_records=" << prelude_records
+              << " prelude_bytes=" << prelude_bytes
+              << " post_warmup_minor_faults="
+              << post_warmup_minor_faults
+              << " post_warmup_major_faults="
+              << post_warmup_major_faults
+              << " prefault=" << (options.prefault ? 1 : 0)
+              << " storage_system_page_bytes=" << systemPageBytes()
+              << " native_prefault_complete="
+              << (backend.nativePrefaultComplete() ? 1 : 0)
+              << " book_universe_sealed="
+              << (backend.bookUniverseSealed() ? 1 : 0)
+              << " prepared_books=" << prepared_books
+              << " native_range_manifest_schema="
+              << kBranch5NativeRangeManifestSchema
+              << " native_range_manifest="
+              << std::quoted(options.native_range_manifest)
+              << " native_range_count=" << native_ranges.count
+              << " native_range_bytes=" << native_ranges.bytes
+              << " native_range_digest=" << native_ranges.digest
+              << " price_internal_node_exhaustions="
+              << price_stats.internal_node_exhaustions
+              << " price_leaf_exhaustions="
+              << price_stats.leaf_exhaustions
+              << " price_level_exhaustions="
+              << price_stats.level_exhaustions
+              << " price_capacity_failures=" << price_failures
+              << " rdtsc_overhead_ticks="
+              << calibration.rdtsc_overhead_ticks
+              << " rdtsc_ticks_per_second="
+              << calibration.rdtsc_ticks_per_second
+              << " now_ns_overhead_ns=" << calibration.now_ns_overhead_ns
+              << " final_live_orders=" << final_live_orders
+              << " phase=" << backend.channelPhaseForAcceptance()
+              << " state_checksum=" << state_checksum
+              << " mutation_digest_enabled="
+              << (options.mutation_digest ? 1 : 0);
+    if (options.mutation_digest) {
+      std::cout << " mutation_digest=" << mutation_digest
+                << " semantic_mutation_digest_enabled=1"
+                << " semantic_mutation_digest_schema="
+                << kSemanticMutationDigestSchema
+                << " semantic_mutation_digest="
+                << semantic_digester->value();
+    } else {
+      std::cout << " semantic_mutation_digest_enabled=0";
+    }
+    std::cout << " p50_ns=" << distribution.p50
+              << " p90_ns=" << distribution.p90
+              << " p99_ns=" << distribution.p99
+              << " p99_9_ns=" << distribution.p999
+              << " max_ns=" << distribution.maximum << '\n';
+
+    for (std::size_t type_index = 0;
+         type_index < kBookMutationTypes.size(); ++type_index) {
+      if (type_distributions[type_index].has_value()) {
+        printTypeDistribution(kBookMutationTypes[type_index],
+                              type_counts[type_index],
+                              *type_distributions[type_index]);
+      } else {
+        std::cout << "itch_book_replay_type"
+                  << " type="
+                  << static_cast<char>(kBookMutationTypes[type_index])
+                  << " sample_count=0 distribution=unavailable\n";
+      }
+    }
+
+    if (final_live_orders != 0 || price_failures != 0 ||
+        backend.channelPhaseForAcceptance() != 7 ||
+        !bookStatsClean(book_stats)) {
+      std::cerr << "full-trace correctness gate failed\n";
+      return EXIT_FAILURE;
+    }
+    if (options.expected_mutation_digest.has_value() &&
+        mutation_digest != *options.expected_mutation_digest) {
+      std::cerr << "mutation digest gate failed\n";
+      return EXIT_FAILURE;
+    }
+    if (options.expected_semantic_mutation_digest.has_value() &&
+        semantic_digester->value() !=
+            *options.expected_semantic_mutation_digest) {
+      std::cerr << "semantic mutation digest gate failed\n";
+      return EXIT_FAILURE;
+    }
+    if (options.require_zero_post_warmup_faults &&
+        (post_warmup_minor_faults != 0 || post_warmup_major_faults != 0)) {
+      std::cerr << "post-warmup page-fault gate failed: minor="
+                << post_warmup_minor_faults
+                << " major=" << post_warmup_major_faults << '\n';
+      return EXIT_FAILURE;
+    }
+#if defined(__x86_64__) || defined(__i386__)
+    if ((options.maximum_p50_ns != 0 &&
+         distribution.p50 > options.maximum_p50_ns) ||
+        (options.maximum_p99_ns != 0 &&
+         distribution.p99 > options.maximum_p99_ns) ||
+        (options.maximum_p999_ns != 0 &&
+         distribution.p999 > options.maximum_p999_ns)) {
+      std::cerr << "latency threshold gate failed\n";
+      return EXIT_FAILURE;
+    }
+#else
+    if (options.maximum_p50_ns != 0 || options.maximum_p99_ns != 0 ||
+        options.maximum_p999_ns != 0) {
+      std::cerr << "latency gate failed: RDTSCP is unavailable on this host\n";
+      return EXIT_FAILURE;
+    }
+#endif
+    return EXIT_SUCCESS;
+  } catch (const std::exception &error) {
+    std::cerr << "ITCH book replay benchmark failed: " << error.what()
+              << '\n';
+    return EXIT_FAILURE;
+  }
+}
diff --git a/benchmarks/Branch5NativeStorage.hpp b/benchmarks/Branch5NativeStorage.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..718baa2da881276c285bb207e06e7f0305754cef
--- /dev/null
+++ b/benchmarks/Branch5NativeStorage.hpp
@@ -0,0 +1,197 @@
+#pragma once
+
+#include "astra/book/BookManager.hpp"
+
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <fcntl.h>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <unistd.h>
+#include <vector>
+
+inline constexpr std::string_view kBranch5HotArenaSchema =
+    "branch5_native_v1";
+inline constexpr std::string_view kBranch5NativeRangeManifestSchema =
+    "branch5_native_ranges_v1";
+
+struct Branch5NativeRange {
+  std::string_view kind;
+  std::uint16_t locate;
+  std::uintptr_t base;
+  std::uint64_t bytes;
+};
+
+struct Branch5NativeRangeSummary {
+  std::uint64_t count{0};
+  std::uint64_t bytes{0};
+  std::uint64_t digest{0};
+};
+
+namespace branch5_native_detail {
+
+inline constexpr std::uint64_t kDigestOffset = 14695981039346656037ull;
+inline constexpr std::uint64_t kDigestPrime = 1099511628211ull;
+
+inline void digestByte(std::uint64_t &digest, std::uint8_t value) noexcept {
+  digest ^= value;
+  digest *= kDigestPrime;
+}
+
+inline void digestU64(std::uint64_t &digest, std::uint64_t value) noexcept {
+  for (unsigned shift = 0; shift < 64; shift += 8)
+    digestByte(digest, static_cast<std::uint8_t>(value >> shift));
+}
+
+inline void digestString(std::uint64_t &digest,
+                         std::string_view value) noexcept {
+  digestU64(digest, value.size());
+  for (char byte : value)
+    digestByte(digest, static_cast<std::uint8_t>(byte));
+}
+
+inline void digestRaw(std::uint64_t &digest, std::string_view value) noexcept {
+  for (char byte : value)
+    digestByte(digest, static_cast<std::uint8_t>(byte));
+}
+
+inline void appendRange(std::vector<Branch5NativeRange> &ranges,
+                        std::string_view kind, std::uint16_t locate,
+                        const void *base, std::size_t bytes) {
+  if (base == nullptr || bytes == 0)
+    throw std::runtime_error("branch5 native storage span is empty");
+  ranges.push_back({kind, locate, reinterpret_cast<std::uintptr_t>(base),
+                    static_cast<std::uint64_t>(bytes)});
+}
+
+inline void writeAll(int descriptor, std::string_view output) {
+  const char *cursor = output.data();
+  std::size_t remaining = output.size();
+  while (remaining != 0) {
+    const ssize_t written = ::write(descriptor, cursor, remaining);
+    if (written < 0 && errno == EINTR)
+      continue;
+    if (written <= 0)
+      throw std::system_error(errno, std::generic_category(),
+                              "write native range manifest");
+    cursor += written;
+    remaining -= static_cast<std::size_t>(written);
+  }
+}
+
+} // namespace branch5_native_detail
+
+inline std::vector<Branch5NativeRange>
+collectBranch5NativeRanges(const BookManager &books) {
+  std::vector<Branch5NativeRange> ranges;
+  ranges.reserve(6 + 4 * BookManager::kMaxStockLocate);
+
+  const PriceLevelArena &prices = books.priceLevelArena();
+  branch5_native_detail::appendRange(ranges, "price_nodes", 0,
+                                     prices.nodesBase(), prices.nodesBytes());
+  branch5_native_detail::appendRange(ranges, "price_leaves", 0,
+                                     prices.leavesBase(),
+                                     prices.leavesBytes());
+  branch5_native_detail::appendRange(ranges, "price_levels", 0,
+                                     prices.levelsBase(),
+                                     prices.levelsBytes());
+  branch5_native_detail::appendRange(ranges, "price_free_nodes", 0,
+                                     prices.freeNodesBase(),
+                                     prices.freeNodesBytes());
+  branch5_native_detail::appendRange(ranges, "price_free_leaves", 0,
+                                     prices.freeLeavesBase(),
+                                     prices.freeLeavesBytes());
+  branch5_native_detail::appendRange(ranges, "price_free_levels", 0,
+                                     prices.freeLevelsBase(),
+                                     prices.freeLevelsBytes());
+
+  for (std::size_t slot = 1; slot < BookManager::kMaxStockLocate; ++slot) {
+    const std::uint16_t locate = static_cast<std::uint16_t>(slot);
+    const OrderBook *const book = books.getOrderBook(locate);
+    if (book == nullptr)
+      continue;
+    branch5_native_detail::appendRange(
+        ranges, "order_records", locate, book->orderRecordsBase(),
+        book->orderRecordsBytes());
+    branch5_native_detail::appendRange(
+        ranges, "order_free_indices", locate, book->orderFreeIndicesBase(),
+        book->orderFreeIndicesBytes());
+    branch5_native_detail::appendRange(
+        ranges, "order_occupancy", locate, book->orderOccupancyBase(),
+        book->orderOccupancyBytes());
+    branch5_native_detail::appendRange(
+        ranges, "order_ref_entries", locate, book->orderRefEntriesBase(),
+        book->orderRefEntriesBytes());
+  }
+  return ranges;
+}
+
+inline Branch5NativeRangeSummary
+summarizeBranch5NativeRanges(const std::vector<Branch5NativeRange> &ranges) {
+  Branch5NativeRangeSummary summary{};
+  summary.count = ranges.size();
+  std::uint64_t digest = branch5_native_detail::kDigestOffset;
+  branch5_native_detail::digestRaw(digest,
+                                   kBranch5NativeRangeManifestSchema);
+  for (const Branch5NativeRange &range : ranges) {
+    if (range.bytes > std::numeric_limits<std::uint64_t>::max() -
+                          summary.bytes) {
+      throw std::overflow_error("branch5 native range byte sum overflow");
+    }
+    summary.bytes += range.bytes;
+    branch5_native_detail::digestString(digest, range.kind);
+    branch5_native_detail::digestU64(digest, range.locate);
+    branch5_native_detail::digestU64(digest, range.base);
+    branch5_native_detail::digestU64(digest, range.bytes);
+  }
+  summary.digest = digest;
+  return summary;
+}
+
+inline Branch5NativeRangeSummary
+writeBranch5NativeRangeManifest(const std::string &path,
+                                const BookManager &books) {
+  if (path.empty())
+    throw std::invalid_argument("native range manifest path is empty");
+  const std::vector<Branch5NativeRange> ranges =
+      collectBranch5NativeRanges(books);
+  const Branch5NativeRangeSummary summary =
+      summarizeBranch5NativeRanges(ranges);
+
+  std::ostringstream output;
+  output << "branch5_native_ranges"
+         << " schema=" << kBranch5NativeRangeManifestSchema
+         << " count=" << summary.count << " bytes=" << summary.bytes
+         << " digest=" << summary.digest << '\n';
+  for (std::size_t index = 0; index < ranges.size(); ++index) {
+    const Branch5NativeRange &range = ranges[index];
+    output << "branch5_native_range"
+           << " ordinal=" << index << " kind=" << range.kind
+           << " locate=" << range.locate << " base=" << range.base
+           << " bytes=" << range.bytes << '\n';
+  }
+
+  const int descriptor =
+      ::open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0644);
+  if (descriptor < 0)
+    throw std::system_error(errno, std::generic_category(),
+                            "create native range manifest");
+  try {
+    branch5_native_detail::writeAll(descriptor, output.str());
+    if (::close(descriptor) != 0)
+      throw std::system_error(errno, std::generic_category(),
+                              "close native range manifest");
+  } catch (...) {
+    const int saved_errno = errno;
+    (void)::close(descriptor);
+    (void)::unlink(path.c_str());
+    errno = saved_errno;
+    throw;
+  }
+  return summary;
+}
diff --git a/benchmarks/Branch5ReplayBackend.hpp b/benchmarks/Branch5ReplayBackend.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..cc5ef1a8c020e0b03145f35a379251bef8f2ffa4
--- /dev/null
+++ b/benchmarks/Branch5ReplayBackend.hpp
@@ -0,0 +1,158 @@
+#pragma once
+
+#include "Branch5NativeStorage.hpp"
+#include "astra/parser/ItchParser.hpp"
+#include "astra/protocol/OrderSide.hpp"
+#include "astra/symbol/StockDirectory.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <span>
+#include <stdexcept>
+#include <string>
+
+struct Branch5ReplayConfig {
+  std::size_t default_order_capacity{
+      astra::book_capacity::kDefaultOrderCapacity};
+  PriceLevelArenaConfig prices{
+      BookManager::kDefaultPriceInternalNodeCapacity,
+      BookManager::kDefaultPriceLeafCapacity,
+      BookManager::kDefaultPriceLevelCapacity};
+};
+
+struct Branch5LogicalOrderState {
+  std::uint64_t reference{0};
+  std::uint32_t quantity{0};
+  std::uint32_t raw_price{0};
+  std::uint16_t locate{0};
+  OrderSide side{OrderSide::Buy};
+  bool active{false};
+};
+
+struct Branch5LogicalLevelState {
+  std::uint64_t total_quantity{0};
+  std::uint32_t order_count{0};
+};
+
+// Compile-time backend for the byte-identical universal replay driver. Every
+// ITCH order mutation carries its stock locate, so correctness observations
+// resolve the native per-book reference table directly without a global map.
+class Branch5ReplayBackend final {
+public:
+  static constexpr std::string_view hotArenaSchema() noexcept {
+    return kBranch5HotArenaSchema;
+  }
+  static constexpr std::string_view nativeRangeManifestSchema() noexcept {
+    return kBranch5NativeRangeManifestSchema;
+  }
+  static constexpr bool requiresStartupPreludeBeforeReady() noexcept {
+    return true;
+  }
+
+  explicit Branch5ReplayBackend(Branch5ReplayConfig config)
+      : config_(config), books_(config.default_order_capacity, config.prices),
+        parser_(symbols_, books_) {}
+
+  bool handleMessage(std::span<const std::byte> message) {
+    const bool terminal = isSystemEvent(message, 'C');
+    const bool applied = parser_.handleMessage(message);
+    if (parser_.bookUniverseReady() && books_.bookUniverseSealed())
+      native_prefault_complete_ = true;
+    if (terminal && parser_.lastError().empty())
+      terminal_end_of_messages_ = true;
+    return applied;
+  }
+
+  const std::string &lastError() const noexcept { return parser_.lastError(); }
+  bool readyForTimedReplay() const noexcept {
+    return native_prefault_complete_;
+  }
+  bool bookUniverseSealed() const noexcept {
+    return books_.bookUniverseSealed();
+  }
+  bool nativePrefaultComplete() const noexcept {
+    // Every fixed vector is walked by its constructor. All per-book vectors
+    // exist only after System Event S prepares and seals the directory.
+    return native_prefault_complete_;
+  }
+  int channelPhaseForAcceptance() const noexcept {
+    return terminal_end_of_messages_ ? 7
+                                     : static_cast<int>(parser_.channelPhase());
+  }
+
+  const Branch5ReplayConfig &config() const noexcept { return config_; }
+  const BookManager &books() const noexcept { return books_; }
+  BookManager &books() noexcept { return books_; }
+
+  std::size_t preparedBooks() const noexcept {
+    std::size_t count = 0;
+    for (std::size_t slot = 1; slot < BookManager::kMaxStockLocate; ++slot) {
+      if (books_.getOrderBook(static_cast<std::uint16_t>(slot)) != nullptr)
+        ++count;
+    }
+    return count;
+  }
+
+  std::uint64_t finalLiveOrders() const noexcept {
+    std::uint64_t count = 0;
+    for (std::size_t slot = 1; slot < BookManager::kMaxStockLocate; ++slot) {
+      const OrderBook *const book =
+          books_.getOrderBook(static_cast<std::uint16_t>(slot));
+      if (book != nullptr)
+        count += book->liveOrderCount();
+    }
+    return count;
+  }
+
+  std::uint64_t priceCapacityFailures() const noexcept {
+    const PriceLevelArenaStats stats = books_.priceLevelArena().stats();
+    return stats.internal_node_exhaustions + stats.leaf_exhaustions +
+           stats.level_exhaustions;
+  }
+
+  std::optional<Branch5LogicalOrderState>
+  findLogicalOrder(std::uint16_t locate, std::uint64_t reference) const {
+    const Order *const order = books_.getOrder(locate, reference);
+    if (order == nullptr)
+      return std::nullopt;
+    if (order->price > std::numeric_limits<std::uint32_t>::max())
+      throw std::runtime_error("branch5 order price exceeds ITCH uint32");
+    return Branch5LogicalOrderState{
+        reference,
+        order->qty,
+        static_cast<std::uint32_t>(order->price),
+        locate,
+        order->side() == 'S' ? OrderSide::Sell : OrderSide::Buy,
+        true,
+    };
+  }
+
+  std::optional<Branch5LogicalLevelState>
+  findLogicalLevel(std::uint16_t locate, std::uint32_t raw_price,
+                   OrderSide side) const noexcept {
+    const OrderBook *const book = books_.getOrderBook(locate);
+    if (book == nullptr)
+      return std::nullopt;
+    const OrderBookLevelSnapshot level = book->getPriceLevel(
+        raw_price, side == OrderSide::Sell ? 'S' : 'B');
+    // The semantic contract represents a missing/just-erased level as a
+    // present logical level with zero aggregates.
+    return Branch5LogicalLevelState{level.total_qty, level.order_count};
+  }
+
+private:
+  static bool isSystemEvent(std::span<const std::byte> message,
+                            char code) noexcept {
+    return message.size() >= 12 && std::to_integer<char>(message[0]) == 'S' &&
+           std::to_integer<char>(message[11]) == code;
+  }
+
+  Branch5ReplayConfig config_;
+  astra::symbol::StockDirectory symbols_;
+  BookManager books_;
+  ItchParser parser_;
+  bool terminal_end_of_messages_{false};
+  bool native_prefault_complete_{false};
+};
diff --git a/benchmarks/Branch5ReplayTime.cpp b/benchmarks/Branch5ReplayTime.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6d0a05f52aa0153d954d51378567e7913bdffd03
--- /dev/null
+++ b/benchmarks/Branch5ReplayTime.cpp
@@ -0,0 +1,124 @@
+#include "astra/core/Time.hpp"
+
+#include <cstdint>
+#include <ctime>
+#include <limits>
+
+#if defined(__x86_64__) || defined(__i386__)
+#include <x86intrin.h>
+#define ASTRA_HAS_RDTSC 1
+#else
+#define ASTRA_HAS_RDTSC 0
+#endif
+
+namespace {
+
+constexpr int kCalibrationSamples = 10000;
+constexpr long double kNsPerSecond = 1'000'000'000.0L;
+
+uint64_t saturatedNsFromTicks(uint64_t ticks,
+                              uint64_t ticks_per_second) noexcept {
+  if (ticks_per_second == 0)
+    return ticks;
+  const long double ns =
+      (static_cast<long double>(ticks) * kNsPerSecond) /
+      static_cast<long double>(ticks_per_second);
+  if (ns >= static_cast<long double>(std::numeric_limits<uint64_t>::max()))
+    return std::numeric_limits<uint64_t>::max();
+  return static_cast<uint64_t>(ns + 0.5L);
+}
+
+uint64_t measureNowNsOverhead() noexcept {
+  uint64_t best = std::numeric_limits<uint64_t>::max();
+  for (int i = 0; i < kCalibrationSamples; ++i) {
+    const uint64_t start = nowNs();
+    const uint64_t end = nowNs();
+    if (end >= start && end - start < best)
+      best = end - start;
+  }
+  return best == std::numeric_limits<uint64_t>::max() ? 0 : best;
+}
+
+uint64_t measureRdtscOverhead() noexcept {
+  uint64_t best = std::numeric_limits<uint64_t>::max();
+  for (int i = 0; i < kCalibrationSamples; ++i) {
+    const uint64_t start = rdtsc();
+    const uint64_t end = rdtsc();
+    if (end >= start && end - start < best)
+      best = end - start;
+  }
+  return best == std::numeric_limits<uint64_t>::max() ? 0 : best;
+}
+
+uint64_t measureRdtscFrequency() noexcept {
+  timespec sleep_time{0, 10'000'000};
+  const uint64_t ns_start = nowNs();
+  const uint64_t ticks_start = rdtsc();
+  nanosleep(&sleep_time, nullptr);
+  const uint64_t ticks_end = rdtsc();
+  const uint64_t ns_end = nowNs();
+  if (ticks_end <= ticks_start || ns_end <= ns_start)
+    return 0;
+  const long double ticks =
+      static_cast<long double>(ticks_end - ticks_start);
+  const long double ns = static_cast<long double>(ns_end - ns_start);
+  return static_cast<uint64_t>((ticks * kNsPerSecond / ns) + 0.5L);
+}
+
+TimeCalibration calibrateTime() noexcept {
+  TimeCalibration calibration{};
+  calibration.now_ns_overhead_ns = measureNowNsOverhead();
+  calibration.rdtsc_overhead_ticks = measureRdtscOverhead();
+  calibration.rdtsc_ticks_per_second = measureRdtscFrequency();
+  return calibration;
+}
+
+} // namespace
+
+uint64_t nowNs() {
+  timespec ts;
+#if defined(CLOCK_MONOTONIC_RAW)
+  clock_gettime(CLOCK_MONOTONIC_RAW, &ts);
+#else
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+#endif
+  return static_cast<uint64_t>(ts.tv_sec) * 1'000'000'000ull +
+         static_cast<uint64_t>(ts.tv_nsec);
+}
+
+uint64_t rdtsc() {
+#if ASTRA_HAS_RDTSC
+  unsigned aux;
+  const uint64_t ticks = __rdtscp(&aux);
+  _mm_lfence();
+  return ticks;
+#else
+  return nowNs();
+#endif
+}
+
+const TimeCalibration &timeCalibration() {
+  static const TimeCalibration calibration = calibrateTime();
+  return calibration;
+}
+
+uint64_t elapsedNs(uint64_t start_ns, uint64_t end_ns) {
+  if (end_ns < start_ns)
+    return 0;
+  const uint64_t elapsed = end_ns - start_ns;
+  const uint64_t overhead = timeCalibration().now_ns_overhead_ns;
+  return elapsed > overhead ? elapsed - overhead : 0;
+}
+
+uint64_t elapsedRdtscNs(uint64_t start_ticks, uint64_t end_ticks) {
+  if (end_ticks < start_ticks)
+    return 0;
+  const TimeCalibration &calibration = timeCalibration();
+  const uint64_t elapsed_ticks = end_ticks - start_ticks;
+  const uint64_t adjusted_ticks =
+      elapsed_ticks > calibration.rdtsc_overhead_ticks
+          ? elapsed_ticks - calibration.rdtsc_overhead_ticks
+          : 0;
+  return saturatedNsFromTicks(adjusted_ticks,
+                              calibration.rdtsc_ticks_per_second);
+}
