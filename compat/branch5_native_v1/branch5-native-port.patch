+void requirePathAbsent(const std::string &path, const char *name) {
+  if (path.empty())
+    return;
+  if (::access(path.c_str(), F_OK) == 0)
+    throw std::runtime_error(std::string(name) + " already exists");
+  if (errno != ENOENT)
+    throw std::runtime_error(std::string("cannot inspect ") + name);
+}
+
+void waitForStartGate(const std::string &path, std::uint64_t timeout_ms) {
+  if (path.empty())
+    return;
+  const auto deadline = std::chrono::steady_clock::now() +
+                        std::chrono::milliseconds(timeout_ms);
+  for (;;) {
+    if (::access(path.c_str(), F_OK) == 0)
+      return;
+    if (errno != ENOENT)
+      throw std::runtime_error("cannot inspect start gate file");
+    if (std::chrono::steady_clock::now() >= deadline)
+      throw std::runtime_error("start gate wait timed out");
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+}
