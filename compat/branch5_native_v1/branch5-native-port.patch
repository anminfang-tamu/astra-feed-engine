+Options parseOptions(int argc, char **argv) {
+  if (argc < 2)
+    throw std::invalid_argument(std::string(kUsage));
+  Options options;
+  options.path = argv[1];
+  for (int index = 2; index < argc; ++index) {
+    const std::string_view argument(argv[index]);
+    const auto valueAfter = [&](std::string_view prefix,
+                                const char *name) -> std::string_view {
+      if (!argument.starts_with(prefix))
+        throw std::logic_error("option prefix mismatch");
+      const std::string_view value = argument.substr(prefix.size());
+      if (value.empty())
+        throw std::invalid_argument(std::string(name) + " cannot be empty");
+      return value;
+    };
+    if (argument == "--prefault") {
+      options.prefault = true;
+    } else if (argument == "--mutation-digest") {
+      options.mutation_digest = true;
+    } else if (argument == "--storage-plan-only") {
+      options.storage_plan_only = true;
+    } else if (argument == "--require-zero-post-warmup-faults") {
+      options.require_zero_post_warmup_faults = true;
+    } else if (argument.starts_with("--sample-every=")) {
+      options.sample_every =
+          parseU64(valueAfter("--sample-every=", "sample interval"),
+                   "sample interval");
+    } else if (argument.starts_with("--warmup-book-messages=")) {
+      options.warmup_book_messages = parseU64(
+          valueAfter("--warmup-book-messages=", "warmup count"),
+          "warmup count");
+    } else if (argument.starts_with("--max-p50-ns=")) {
+      options.maximum_p50_ns =
+          parseU64(valueAfter("--max-p50-ns=", "p50 gate"), "p50 gate");
+    } else if (argument.starts_with("--max-p99-ns=")) {
+      options.maximum_p99_ns =
+          parseU64(valueAfter("--max-p99-ns=", "p99 gate"), "p99 gate");
+    } else if (argument.starts_with("--max-p99-9-ns=")) {
+      options.maximum_p999_ns = parseU64(
+          valueAfter("--max-p99-9-ns=", "p99.9 gate"), "p99.9 gate");
+    } else if (argument.starts_with("--min-samples=")) {
+      options.minimum_samples = parseU64(
+          valueAfter("--min-samples=", "minimum samples"),
+          "minimum samples");
+    } else if (argument.starts_with("--expect-records=")) {
+      options.expected_records = parseU64(
+          valueAfter("--expect-records=", "expected records"),
+          "expected records");
+    } else if (argument.starts_with("--expect-bytes=")) {
+      options.expected_bytes =
+          parseU64(valueAfter("--expect-bytes=", "expected bytes"),
+                   "expected bytes");
+    } else if (argument.starts_with("--sample-capacity=")) {
+      options.sample_capacity = parseSize(
+          valueAfter("--sample-capacity=", "sample capacity"),
+          "sample capacity");
+    } else if (argument.starts_with("--default-order-capacity=")) {
+      options.default_order_capacity = parseSize(
+          valueAfter("--default-order-capacity=", "default order capacity"),
+          "default order capacity");
+    } else if (argument.starts_with("--price-node-capacity=")) {
+      options.price_node_capacity = parseSize(
+          valueAfter("--price-node-capacity=", "price node capacity"),
+          "price node capacity");
+    } else if (argument.starts_with("--price-leaf-capacity=")) {
+      options.price_leaf_capacity = parseSize(
+          valueAfter("--price-leaf-capacity=", "price leaf capacity"),
+          "price leaf capacity");
+    } else if (argument.starts_with("--price-level-capacity=")) {
+      options.price_level_capacity = parseSize(
+          valueAfter("--price-level-capacity=", "price level capacity"),
+          "price level capacity");
+    } else if (argument.starts_with("--native-range-manifest=")) {
+      options.native_range_manifest = std::string(valueAfter(
+          "--native-range-manifest=", "native range manifest"));
+    } else if (argument.starts_with("--start-gate-file=")) {
+      options.start_gate_file =
+          std::string(valueAfter("--start-gate-file=", "start gate file"));
+    } else if (argument.starts_with("--start-gate-timeout-ms=")) {
+      options.start_gate_timeout_ms = parseU64(
+          valueAfter("--start-gate-timeout-ms=", "start gate timeout"),
+          "start gate timeout");
+    } else if (argument.starts_with("--expect-mutation-digest=")) {
+      options.expected_mutation_digest = parseU64(
+          valueAfter("--expect-mutation-digest=", "expected mutation digest"),
+          "expected mutation digest");
+      options.mutation_digest = true;
+    } else if (argument.starts_with("--expect-semantic-mutation-digest=")) {
+      options.expected_semantic_mutation_digest = parseU64(
+          valueAfter("--expect-semantic-mutation-digest=",
+                     "expected semantic mutation digest"),
+          "expected semantic mutation digest");
+      options.mutation_digest = true;
+    } else if (argument.starts_with("--direct-order-slots=") ||
+               argument.starts_with("--fallback-buckets=") ||
+               argument.starts_with("--price-page-capacity=")) {
+      throw std::invalid_argument(
+          "redesign storage option is not valid for branch5_native_v1");
+    } else {
+      throw std::invalid_argument("unknown option: " + std::string(argument));
+    }
+  }
+
+  if (options.sample_every == 0 || options.minimum_samples == 0 ||
+      options.sample_capacity == 0 || options.default_order_capacity == 0 ||
+      options.price_node_capacity < 2 || options.price_leaf_capacity == 0 ||
+      options.price_level_capacity == 0)
+    throw std::invalid_argument("capacity/count options must be nonzero");
+  if (options.minimum_samples > options.sample_capacity)
+    throw std::invalid_argument(
+        "minimum samples cannot exceed sample capacity");
+  if (options.start_gate_timeout_ms == 0 ||
+      options.start_gate_timeout_ms > 3'600'000)
+    throw std::invalid_argument(
+        "start gate timeout must be in [1, 3600000] milliseconds");
+  if (!options.storage_plan_only && options.native_range_manifest.empty())
+    throw std::invalid_argument(
+        "branch5 replay requires --native-range-manifest=PATH");
+  const bool latency_gate = options.maximum_p50_ns != 0 ||
+                            options.maximum_p99_ns != 0 ||
+                            options.maximum_p999_ns != 0;
+  if (options.mutation_digest && latency_gate)
+    throw std::invalid_argument(
+        "mutation digest and latency threshold gates require separate runs");
+  return options;
+}
