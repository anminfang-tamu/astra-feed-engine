+  const PriceLevelIndex::Side index_side =
+      side == 'S' ? PriceLevelIndex::Side::Ask : PriceLevelIndex::Side::Bid;
+  const PriceLevelHandle handle = price_level_index_.find(price, index_side);
+  const PooledPriceLevel *const level = price_level_arena_.level(handle);
